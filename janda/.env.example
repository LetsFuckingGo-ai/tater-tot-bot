# Password Alba uses to log in at /admin
ADMIN_PASSWORD=
# Secret key your marketing bot sends as "Authorization: Bearer <key>". Generate with: openssl rand -hex 24
BOT_API_KEY=
# Optional: URL that receives a POST every time a new order/inquiry/subscriber arrives (n8n, Zapier, Make, your bot)
WEBHOOK_URL=
# Optional: WhatsApp number with country code, digits only (can also be set in /admin → Ajustes)
WHATSAPP_NUMBER=
# Where the database and uploaded photos live. Point it at a persistent disk in production.
DATA_DIR=./data
PORT=3000
